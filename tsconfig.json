{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowSyntheticDefaultImports": true, "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "baseUrl": ".", "paths": {"@atlas/ui/*": ["packages/ui/src/*"], "@atlas/schemas": ["packages/schemas/src/index.ts"]},
    "noEmit": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "packages/**/*.vue", "scripts/**/*.ts", "tests/**/*.ts", "knowledge/published/.vitepress/**/*.ts", "knowledge/published/.vitepress/**/*.vue"]
}
