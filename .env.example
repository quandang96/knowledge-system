# Development login is available ONLY over loopback. Copy to .env and change passwords.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
AUTH_MODE=local
LOCAL_ADMIN_PASSWORD=atlas-demo-2026
LOCAL_EDITOR_PASSWORD=atlas-editor-2026
LOCAL_PUBLISHER_PASSWORD=atlas-publisher-2026
LOCAL_READER_PASSWORD=atlas-reader-2026
# Persistent volume: must contain published/ (including .vitepress), drafts/ and state.
KNOWLEDGE_ROOT=./knowledge
# Production requires AUTH_MODE=proxy, NODE_ENV=production, and the approved gateway.
# PROXY_SHARED_SECRET=replace-with-at-least-32-random-characters
# Proxy overwrites X-Atlas-Proxy-Secret, X-Atlas-User, X-Atlas-Role.
# COOKIE_SECURE=true
# API_HOST=0.0.0.0
# ALLOWED_ORIGIN=https://your-authenticated-coder-app.example
