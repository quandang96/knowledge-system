{
  "name": "atlas-knowledge-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "workspaces": ["apps/api", "packages/ui", "packages/schemas"],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "tsx scripts/dev-web.ts",
    "build": "tsx scripts/build-web.ts",
    "build:web": "tsx scripts/build-web.ts",
    "start": "tsx apps/api/src/server.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/publish-smoke.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint apps packages scripts tests knowledge/published/.vitepress",
    "validate": "tsx scripts/validate-knowledge.ts",
    "backup": "tsx scripts/backup-knowledge.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@mdi/font": "^7.4.47",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.12.1",
    "sharp": "^0.34.4",
    "vue": "^3.5.22",
    "vuetify": "3.13.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.18.10",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitepress": "1.6.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
